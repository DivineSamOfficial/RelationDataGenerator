# Copy to .env and fill in. Never commit .env.

# Optional overrides of config/database.yaml
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Admin login: used only by `scmgen db init` (and `db check`) to create users, schemas
# and the control registry. On a fresh Homebrew install this is root with an empty password.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Service-account passwords. Leave these out: `scmgen db init` generates strong random
# passwords and writes them here. User names come from config/database.yaml (users:).
# MYSQL_PASSWORD=            # scm_app      (all normal work)
# MYSQL_READER_PASSWORD=     # scm_reader   (read-only, DuckDB loader)
# MYSQL_ANOMALY_PASSWORD=    # scm_anomaly  (anomaly tooling; read-only on clean data)
