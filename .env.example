# Copy to .env and fill in. Never commit .env.

# Optional overrides of config/database.yaml
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Admin login: used only to create users, schemas and the control registry
# (scmgen db check / db init). On a fresh Homebrew install this is root with
# an empty password.
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=

# Application login used for everything else (created in Phase 2 step 2.2).
MYSQL_USER=scm_app
MYSQL_PASSWORD=change_me
